#!/usr/bin/env zsh

# Pulumi Functions

# Run a pulumi command against one of the highlander pulumi projects, without having
# to remember which pnpm package and which per-project script wraps it.
#
#   pulumi_deploy <target> [pulumi args...]
#   pulumi_deploy            # no target: list every target in this workspace
#
# Targets are discovered, not hardcoded. Every directory with a Pulumi.yaml and a
# package.json is scanned for scripts that END in `pulumi --stack <stack>` -- the ones
# that pass extra arguments straight to pulumi. Each becomes a target named
# `<Pulumi.yaml project>:<last stack segment>`, e.g. `kubernetes:integration-eu` or
# `azure-services:prod-us2`. So a new stack or a renamed script shows up on its own.
#
# Deliberately not discovered:
#   - scripts that already carry a command (`pulumi preview --stack dev`), since
#     anything appended would be a second command
#   - scripts with no `--stack` (aws-infra, gcp-infra), which would act on whatever
#     stack happens to be selected
#
# Short names kept for muscle memory:
#   cloudflare (cf)               the script has no --stack, so it is supplied here
#   datadog (dd)                  -> datadog:main
#   integration-us1 (int)         -> kubernetes:integration
#   staging-us1 (staging, stg)    -> kubernetes:staging
#   prod-us1 (prod)               -> kubernetes:prod
#
# Everything after the target is passed straight through, so:
#   pulumi_deploy staging-us1 preview --diff
#   pulumi_deploy azure-services:staging-us2 preview --diff
#   pulumi_deploy cloudflare preview --diff --target 'urn:pulumi:cloudflare::...'
#
# Each project's script wraps pulumi in `op run --env-file ...`, so a live 1Password
# session is required; `op signin` first if you get "authorization timeout".

# The pnpm workspace to run in. `pnpm --filter` only resolves a package from inside the
# workspace, so prefer the one we are standing in (there may be several checkouts or
# worktrees) and only then fall back to $HIGHLANDER_DIR.
function _pulumi_deploy_root () {
    local root="$PWD"
    while [[ "$root" != "/" && ! -f "$root/pnpm-workspace.yaml" ]]; do
        root="${root:h}"
    done
    if [[ ! -f "$root/pnpm-workspace.yaml" ]]; then
        root="${HIGHLANDER_DIR:-$HOME/code/highlander-voice}"
    fi
    [[ -f "$root/pnpm-workspace.yaml" ]] || return 1
    print -r -- "$root"
}

# One line per discovered target: target<TAB>package<TAB>script<TAB>stack.
# git ls-files keeps node_modules and build output out; ~30ms for the whole repo.
function _pulumi_deploy_discover () {
    local root="$1" yaml dir project
    for yaml in ${(f)"$(git -C "$root" ls-files '*Pulumi.yaml' 2>/dev/null)"}; do
        dir="$root/${yaml:h}"
        [[ -f "$dir/package.json" ]] || continue
        project="$(sed -n 's/^name:[[:space:]]*//p' "$root/$yaml" | head -1)"
        [[ -n "$project" ]] || continue
        jq -r --arg project "$project" '
            .name as $pkg
            | (.scripts // {}) | to_entries[]
            | select(.value | test("(^|[ /])pulumi --stack[= ][^ ]+ *$"))
            | (.value | capture("--stack[= ](?<s>[^ ]+) *$").s) as $stack
            | [($project + ":" + ($stack | split("/") | last)), $pkg, .key, $stack]
            | @tsv' "$dir/package.json" 2>/dev/null
    done
}

function _pulumi_deploy_list () {
    local root="$1"
    print "Short names: cloudflare (cf), datadog (dd), integration-us1 (int), staging-us1 (stg), prod-us1 (prod)"
    print "Discovered in $root:"
    _pulumi_deploy_discover "$root" | awk -F'\t' '{ printf "  %-40s %s %s\n", $1, $2, $3 }'
}

function pulumi_deploy () {
    local root
    if ! root="$(_pulumi_deploy_root)"; then
        echo "pulumi_deploy: not inside a pnpm workspace, and \$HIGHLANDER_DIR is unset or wrong"
        echo "  cd into the monorepo, or: export HIGHLANDER_DIR=/path/to/highlander"
        return 1
    fi

    local target="$1"
    if [[ -z "$target" ]]; then
        echo "Usage: pulumi_deploy <target> [pulumi args...]"
        _pulumi_deploy_list "$root"
        return 1
    fi
    shift

    case "$target" in
        cloudflare|cf)
            # Unlike the others, this script does not bake in a stack.
            pnpm -C "$root" --filter @magi/infra-cloudflare pulumi --stack mavenagi/cloudflare "$@"
            return
            ;;
        datadog|dd)                       target="datadog:main" ;;
        integration-us1|integration|int)  target="kubernetes:integration" ;;
        staging-us1|staging|stg)          target="kubernetes:staging" ;;
        prod-us1|prod)                    target="kubernetes:prod" ;;
    esac

    local line
    line="$(_pulumi_deploy_discover "$root" | awk -F'\t' -v t="$target" '$1 == t { print; exit }')"
    if [[ -z "$line" ]]; then
        echo "pulumi_deploy: unknown target '$target'"
        _pulumi_deploy_list "$root"
        return 1
    fi

    local -a fields
    fields=("${(@ps:\t:)line}")
    pnpm -C "$root" --filter "$fields[2]" "$fields[3]" "$@"
}
