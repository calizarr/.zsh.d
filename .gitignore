
# Created by https://www.gitignore.io/api/zsh
# Edit at https://www.gitignore.io/?templates=zsh

### Zsh ###
# Zsh compiled script + zrecompile backup
*.zwc
*.zwc.old

# Zsh completion-optimization dumpfile
*zcompdump*

# Zsh zcalc history
.zcalc_history

# A popular plugin manager's files
._zplugin
.zplugin_lstupd

# zdharma/zshelldoc tool's files
zsdoc/data

# robbyrussell/oh-my-zsh/plugins/per-directory-history plugin's files
# (when set-up to store the history in the local directory)
.directory_history

# MichaelAquilina/zsh-autoswitch-virtualenv plugin's files
# (for Zsh plugins using Python)
.venv

# Zunit tests' output
/tests/_output/*
!/tests/_output/.gitkeep

# End of https://www.gitignore.io/api/zsh

!.zsh*

# Shell history and session state. Routinely contains credentials typed on the
# command line, and is machine-local state rather than configuration. These must
# come AFTER the `!.zsh*` un-ignore above -- in gitignore, the last matching rule wins.
.zsh_history
.zsh_sessions/
