#compdef pulumi_deploy

# Completion for pulumi_deploy (defined in $ZDOTDIR/personal_funcs/_pulumi).
#
# ---------------------------------------------------------------------------
# This directory is on $fpath directly (see .zshrc, next to the
# $USER_SITEFUNCTIONS line), so completions live in this repo and are
# version-controlled. No symlinking into ~/.local/share required.
#
# How zsh picks this up, since it is not obvious the first time:
#
#   1. The FIRST LINE must be `#compdef <command>`. That is not a comment to
#      zsh -- compinit scans for it to learn which command the file completes.
#   2. The file must be named `_<something>` and be reachable via $fpath.
#   3. compinit then AUTOLOADS it lazily on the first Tab. There is no
#      `compdef` call anywhere; the marker line replaces it.
#
# Why this is not inlined next to the function: $ZDOTDIR/personal_funcs/* are
# `source`d around line 136 of .zshrc, but `compinit` does not run until ~294,
# and `compdef` does not exist until compinit defines it -- so an inline
# `compdef` there would run too early. A file in $fpath sidesteps the ordering.
#
# Note that personal_funcs is deliberately NOT on $fpath (those files are
# sourced). That is the only reason a function file can be called `_pulumi`
# there without zsh mistaking it for a completion for a command named `pulumi`.
#
# After adding or editing this file, start a new shell. If completion does not
# show up, the compdump is stale: rm -f "$ZDOTDIR"/.zcompdump* and restart.
# ---------------------------------------------------------------------------

_pulumi_deploy() {
    local curcontext="$curcontext" state
    local -a targets commands

    # `_describe` takes 'value:description' pairs and shows the descriptions
    # next to each completion. The long short-names are offered; the two-letter
    # aliases (cf, dd, int, stg, prod) still work when typed, they are just not
    # offered, which keeps the menu readable.
    targets=(
        'cloudflare:Cloudflare DNS/tunnels/access (stack mavenagi/cloudflare)'
        'datadog:= datadog:main'
        'integration-us1:= kubernetes:integration'
        'staging-us1:= kubernetes:staging'
        'prod-us1:= kubernetes:prod'
    )

    # Everything else comes from the workspace's package.json scripts (see
    # _pulumi_deploy_discover in personal_funcs/_pulumi). Target names contain
    # ":", which _describe would read as the description separator, so escape it.
    local root line
    local -a fields
    if (( $+functions[_pulumi_deploy_root] )) && root="$(_pulumi_deploy_root)"; then
        for line in ${(f)"$(_pulumi_deploy_discover "$root")"}; do
            fields=("${(@ps:\t:)line}")
            targets+=("${fields[1]//:/\\:}:${fields[2]} ${fields[3]} (stack ${fields[4]})")
        done
    fi

    # Read from `pulumi --help` rather than hardcoded, so the list tracks the
    # installed CLI. Every command line sits under a "... Commands:" heading,
    # indented two spaces as `name   description`; parsing stops at "Flags:".
    # Cached for the life of the shell: the first Tab costs ~0.2s, the rest
    # nothing. After upgrading pulumi, `unset _PULUMI_DEPLOY_COMMANDS` (or open
    # a new shell) to re-read it.
    if (( ! ${+_PULUMI_DEPLOY_COMMANDS} )); then
        typeset -ga _PULUMI_DEPLOY_COMMANDS
        _PULUMI_DEPLOY_COMMANDS=(${(f)"$(
            pulumi --help 2>/dev/null | awk '
                /^Flags:/            { exit }
                /Commands:$/         { in_cmds = 1; next }
                in_cmds && /^  [a-z]/ {
                    name = $1; $1 = ""; sub(/^ +/, "")
                    gsub(/:/, "\\:")   # _describe splits value from description on ":"
                    print name ":" $0
                }'
        )"})
    fi
    commands=("${_PULUMI_DEPLOY_COMMANDS[@]}")

    # `_arguments -C` with `->state` defers instead of completing inline: it
    # sets $state and lets the case below decide. `1:`/`2:` are positional
    # slots; `*::` collects everything after and hands it to _default, since
    # pulumi's own flags are open-ended and not worth enumerating here.
    _arguments -C \
        '1:target:->target' \
        '2:command:->command' \
        '*::pulumi args:_default'

    case "$state" in
        target)
            _describe -t targets 'pulumi_deploy target' targets
            ;;
        command)
            _describe -t commands 'pulumi command' commands
            ;;
    esac
}

_pulumi_deploy "$@"
